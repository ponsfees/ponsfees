# /root/fees-ops/api.env (0600). ⛔ Never commit the filled copy.
PUBLIC_URL=https://ponsfees.family
LOGO_PUBLIC_BASE=https://ponsfees.family/logos
RHC_RPC=https://rpc.mainnet.chain.robinhood.com
LAUNCHPAD=0x…
CLAIMS_ADDRESS=0x…
# The voucher signer. Must equal FeesClaims.signer(). It can sign vouchers and nothing else.
CLAIM_SIGNER_KEY=0x…

# Sign in with X (developer.x.com, OAuth 2.0, callback https://ponsfees.family/api/auth/callback/x)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Handle lookups for the launch form: twitterapi.io key (preferred) or an X app bearer token.
TWITTERAPI_IO_KEY=
X_BEARER_TOKEN=

# Sign in with GitHub (github.com/settings/developers, callback https://ponsfees.family/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sign in with Twitch (dev.twitch.tv/console, callback https://ponsfees.family/api/auth/callback/twitch).
# The same pair also powers channel lookups (app access token), so no extra key is needed.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
